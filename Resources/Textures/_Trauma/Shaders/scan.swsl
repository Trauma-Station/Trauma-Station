light_mode unshaded;

uniform highp float zoom;
uniform highp float angle;
uniform highp float ratio;
uniform highp vec3 scanColor;
uniform highp float scanDensity;
uniform highp float scanAlpha;

void fragment()
{
    highp vec4 sprite = zTexture(UV);

    if (sprite.a == 0.0) {
        discard;
    }

    highp vec4 effectColor = sprite;

    highp vec2 dir = UV2 - vec2(0.5);
    highp float rotated = dir.x * cos(angle) - dir.y * sin(angle) + 0.5;

    highp float scanned = abs(rotated - ratio);

    if (rotated <= ratio)
    {
        highp float scanPattern = sin(rotated * scanDensity / zoom) * 0.5 + 0.5;

        highp vec3 areaColor = scanColor * (scanPattern * 0.6 + 0.4);
        effectColor = vec4(areaColor, scanAlpha);
    }

    float laserCore = smoothstep(0.005, 0.0, scanned);
    float laserGlow = exp(-scanned * 20.0);

    highp vec3 glowColor = scanColor * (laserCore + laserGlow * 0.6);

    effectColor.rgb += glowColor;
    effectColor.a = max(effectColor.a, laserCore + laserGlow);

    COLOR.rgb = mix(effectColor.rgb, sprite.rgb, effectColor.a) * sprite.a;
    COLOR.a = sprite.a;
}
