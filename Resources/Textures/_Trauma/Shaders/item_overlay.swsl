uniform highp float pixelSize;
uniform highp float rot;
uniform highp vec2 ratio;
uniform highp vec2 scale;
uniform sampler2D overlayTexture;

void fragment()
{
    highp vec4 sprite = zTexture(UV);
	if (sprite.a == 0.0) {
		discard;
	}

    highp float sn = sin(rot);
    highp float cs = cos(rot);

    // Flip x and y coords to fit some sprites better and rotate based on rot
    highp vec2 rotatedUV = vec2(UV2.y - 0.5, UV2.x - 0.5) * mat2(cs, -sn, sn, cs);

    // Fix rotation scaling
    rotatedUV *= abs(sn) + abs(cs);

    // Pixelate
    highp vec2 ps = scale * pixelSize;
    rotatedUV = round(rotatedUV * ps) / ps;

    rotatedUV = rotatedUV / ratio + 0.5;

    highp vec4 col = zTextureSpec(overlayTexture, rotatedUV);

    COLOR = vec4(mix(sprite.rgb, col.rgb, col.a), sprite.a);
}
