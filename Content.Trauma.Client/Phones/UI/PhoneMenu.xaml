<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
    Title="Telephone" MinSize="135 90" Resizable="False">
    <GridContainer Columns="2">
    <BoxContainer Orientation="Vertical">
        <controls:StripeBack>
            <BoxContainer Orientation="Horizontal" Align="Center">
                <GridContainer Columns="3"
                               Name="KeypadGrid">
                    <!-- Keypad is filled by code -->
                </GridContainer>
            </BoxContainer>
        </controls:StripeBack>
        <RichTextLabel Name="DialNumber" Text="" Access="Public" HorizontalAlignment="Center"></RichTextLabel>
    </BoxContainer>
<!-- phonebook is filled by code -->
    <ScrollContainer MinSize="250 90">
        <BoxContainer MinSize="100 90" Orientation="Vertical" Name="PhoneBookContainer" Access="Public">
        </BoxContainer>
    </ScrollContainer>
    </GridContainer>
</controls:FancyWindow>
