<Control xmlns="https://spacestation14.io">
    <BoxContainer Margin="8,8,8,8" Orientation="Vertical">
        <BoxContainer Orientation="Horizontal">
            <Label Name="JobListingsName" HorizontalExpand="True" />
            <Button
                Name="JobListingCancelButton"
                StyleClasses="negative"
                MinWidth="64"
                HorizontalAlignment="Right"
                Access="Public"
                Text="{Loc job-listings-ui-cancel-button}"/>
            <Button
                Name="JobListingAcceptButton"
                MinWidth="64"
                HorizontalAlignment="Right"
                Access="Public"
                Text="{Loc job-listings-ui-accept-button}"/>
            <Button
                Name="JobListingClaimButton"
                MinWidth="64"
                HorizontalAlignment="Right"
                Access="Public"
                Text="{Loc job-listings-ui-claim-button}"/>
        </BoxContainer>
        <PanelContainer StyleClasses="HighDivider" />
        <BoxContainer HorizontalExpand="True" Orientation="Horizontal">
            <TextureRect
                Name="JobListingTexture"
                Margin="0,0,4,0"
                MinSize="48 48"
                Stretch="KeepAspectCentered" />
            <Control MinWidth="5"/>
            <BoxContainer Orientation="Vertical">
                <RichTextLabel Name="JobListingDescription" />
                <RichTextLabel Name="JobListingReward" />
                <ProgressBar Name="JobListingProgress"
                             HorizontalAlignment="Left"
                             MinValue="0"
                             MaxValue="1"
                             SetSize="250 20"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</Control>
