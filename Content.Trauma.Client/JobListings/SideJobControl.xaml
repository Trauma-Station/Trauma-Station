<Control xmlns="https://spacestation14.io"
        xmlns:controls="using:Content.Client.UserInterface.Controls">
    <BoxContainer Margin="8,8,8,8" Orientation="Vertical">
        <BoxContainer Orientation="Horizontal">
            <Label Name="NameLabel" HorizontalExpand="True" />
            <controls:ConfirmButton
                Name="CancelButton"
                StyleClasses="negative"
                MinWidth="64"
                HorizontalAlignment="Right"
                Text="Cancel"
                ConfirmationText="Sure?"/>
            <Button
                Name="AcceptButton"
                MinWidth="64"
                HorizontalAlignment="Right"
                Text="{Loc job-listings-ui-accept-button}"/>
            <Button
                Name="ClaimButton"
                MinWidth="64"
                HorizontalAlignment="Right"
                Text="{Loc job-listings-ui-claim-button}"/>
        </BoxContainer>
        <PanelContainer StyleClasses="HighDivider" />
        <BoxContainer HorizontalExpand="True" Orientation="Horizontal">
            <TextureRect
                Name="ListingTexture"
                Margin="0,0,4,0"
                MinSize="48 48"
                Stretch="KeepAspectCentered" />
            <Control MinWidth="5"/>
            <BoxContainer Orientation="Vertical">
                <RichTextLabel Name="DescriptionLabel" />
                <RichTextLabel Name="RewardLabel" />
                <BoxContainer Orientation="Horizontal">
                    <RichTextLabel Name="ProgressLabel"/>
                    <ProgressBar Name="ProgressBar"
                                 HorizontalAlignment="Left"
                                 MinValue="0"
                                 MaxValue="1"
                                 Margin="5 0 0 0"
                                 SetSize="200 20"/>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</Control>
