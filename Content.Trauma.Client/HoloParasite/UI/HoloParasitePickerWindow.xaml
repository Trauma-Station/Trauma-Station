<controls:FancyWindow xmlns="https://spacestation14.io"
        xmlns:controls="using:Content.Client.UserInterface.Controls"
        xmlns:gfx="using:Robust.Client.Graphics"
        Title="{Loc 'holoparasite-picker-window-title'}"
        MinSize="760 520"
        SetSize="760 520">
    <BoxContainer Orientation="Horizontal" Margin="8">

        <BoxContainer Name="StagePane" Orientation="Vertical" MinSize="300 0" Margin="4 4 8 4">
            <PanelContainer HorizontalExpand="True" VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#0b0d13" BorderColor="#2b3038" BorderThickness="2 2 2 2" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" Margin="8" VerticalExpand="True">

                    <EntityPrototypeView Name="Preview" SetSize="128 128" Scale="5 5" HorizontalAlignment="Center" VerticalExpand="True"/>

                    <Label Name="VariantCaption" Align="Center" HorizontalExpand="True" StyleClasses="LabelBig" Margin="0 10 0 0" ClipText="True"/>
                    <RichTextLabel Name="VariantSynopsis" HorizontalExpand="True" VerticalExpand="True" Margin="0 6 0 0"/>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

        <BoxContainer Orientation="Vertical" SizeFlagsStretchRatio="1.5" HorizontalExpand="True" Margin="4 4 2 0">

            <GridContainer Name="VariantGrid" Columns="2" HorizontalExpand="True" VerticalExpand="True" HSeparationOverride="6" VSeparationOverride="6"/>

            <PanelContainer HorizontalExpand="True" Margin="0 6 0 0">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#0b0d13" BorderColor="#23262d" BorderThickness="1 1 1 1" />
                </PanelContainer.PanelOverride>
                <RichTextLabel Name="VariantLore" HorizontalExpand="True" VerticalExpand="True" Margin="6" />
            </PanelContainer>

            <controls:StripeBack HorizontalAlignment="Right" MaxWidth="240" Margin="0 6 0 0">
                <controls:ConfirmButton Name="BindButton" Text="{Loc 'holoparasite-picker-confirm'}" Margin="4" HorizontalExpand="True"/>
            </controls:StripeBack>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
