<ContainerButton xmlns="https://spacestation14.io"
        xmlns:graphics="using:Robust.Client.Graphics"
        Margin="6"
        Disabled="True">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <graphics:StyleBoxFlat BackgroundColor="#444400" BorderThickness="2" BorderColor="#550000"/>
        </PanelContainer.PanelOverride>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="4">
            <Label Name="TaskName" HorizontalExpand="True"/>
            <Label Name="Status" Visible="False"/>
        </BoxContainer>
    </PanelContainer>
</ContainerButton>
