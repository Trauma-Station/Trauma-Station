<Control xmlns="https://spacestation14.io">
    <BoxContainer Margin="8,8,8,8" Orientation="Vertical">
        <Label Name="RewardName" HorizontalExpand="True" />
        <BoxContainer HorizontalExpand="True" Margin="0 2" Orientation="Horizontal">
            <PanelContainer StyleClasses="PanelLight" Margin="5 0" SetWidth="1" />
            <TextureRect
                Name="RewardTexture"
                Margin="0,0,4,0"
                MinSize="48 48"
                Stretch="KeepAspectCentered" />
            <Control MinWidth="5" />
            <RichTextLabel Name="RewardDescription" />
        </BoxContainer>
        <Collapsible>
            <CollapsibleHeading Name="RewardReward" />
            <CollapsibleBody Margin="10 0 0 0">
                <BoxContainer HorizontalExpand="True" Orientation="Horizontal">
                    <PanelContainer StyleClasses="PanelLight" Margin="5 0" SetWidth="1" />
                    <TextureRect
                        Name="RewardRewardTexture"
                        Margin="0,0,4,0"
                        MinSize="48 48"
                        Stretch="KeepAspectCentered" />
                    <Control MinWidth="5" />
                    <RichTextLabel Name="RewardRewardDescription" />
                </BoxContainer>
            </CollapsibleBody>
        </Collapsible>
    </BoxContainer>
    <PanelContainer StyleClasses="SpyRewardClaimed" HorizontalExpand="True" VerticalExpand="True"
                    Name="ClaimedPanel" Visible="False">
        <Label StyleClasses="SpyRewardClaimed" HorizontalAlignment="Center" VerticalAlignment="Center"
               Text="{Loc 'spy-uplink-claimed'}" />
    </PanelContainer>
</Control>
