<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
    Title="{Loc 'spy-uplink-title'}"
    MinSize="512 512"
    SetSize="512 512"
    Stylesheet="SpyUplink">
    <BoxContainer Orientation="Vertical">
        <Label Name="RefreshTimeLabel" Access="Public" Margin="5 5 0 0" HorizontalAlignment="Left"/>
        <controls:HLine StyleClasses="PanelLight" Margin="0 5 0 0" Thickness="1"/>
        <BoxContainer Orientation="Vertical" VerticalExpand="True">
            <PanelContainer StyleClasses="BackgroundPanelDark" VerticalExpand="True">
                <ScrollContainer
                    Name="BountiesScroll"
                    HScrollEnabled="False"
                    HorizontalExpand="True"
                    MinSize="100 256"
                    SizeFlagsStretchRatio="2"
                    VerticalExpand="True">
                    <BoxContainer
                        Name="BountiesContainer"
                        MinSize="100 256"
                        Orientation="Vertical"
                        SizeFlagsStretchRatio="2"
                        VerticalExpand="True">
                        <!--  Bounties are added here by code  -->
                    </BoxContainer>
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>

        <!-- Footer -->
        <BoxContainer Orientation="Vertical" Name="UplinkFooter">
            <PanelContainer StyleClasses="LowDivider" />
            <Label Text="{Loc 'spy-uplink-flavor'}" Margin="10 2 5 2" HorizontalAlignment="Left"
                StyleClasses="WindowFooterText" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
